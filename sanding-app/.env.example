# Copy to .env.local. Local values come from `npx supabase status -o env`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Random string; salts the IP hashes used for guest rate limits.
RATE_LIMIT_SALT=change-me

# Payments: "mock" runs a local stand-in gateway page; "toyyibpay" uses ToyyibPay.
PAYMENT_PROVIDER=mock
# ToyyibPay sandbox: sign up at https://dev.toyyibpay.com, create a category, copy both values here.
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
# true (default) = dev.toyyibpay.com sandbox, false = live toyyibpay.com
TOYYIBPAY_SANDBOX=true
# Public URL ToyyibPay can POST callbacks to (e.g. an ngrok/cloudflared tunnel). Optional locally:
# the return page also verifies the bill with getBillTransactions.
PAYMENT_CALLBACK_BASE_URL=

# Email after payment (card link + how-to steps), sent with Resend (https://resend.com). Leave empty to skip.
# EMAIL_FROM must be on a domain verified in Resend, e.g. "Sanding <kad@kadkahwin.website>".
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
